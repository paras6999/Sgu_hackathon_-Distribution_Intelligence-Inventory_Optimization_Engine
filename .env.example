# Copy to .env in the repo root (git-ignored). The backend reads it at start-up, so restart it after editing.

# --- backend
PORT=8000
ENGINE_MODE=source            # fake | source | binary
ENGINE_PORT=7010
# ENGINE_URL=http://127.0.0.1:7010   # attach to an engine you started yourself
# ENGINE_BIN=dist/dia-engine/dia-engine
# DIA_BACKEND_DATA_DIR=data/backend
# DIA_DATA_DIR=data/engine

# --- optional AI narration and analysis on demand (off by default; never commit real values)
# With AI_ENABLED=false the Analyse buttons still work, from rules and templates, with the network off.
AI_ENABLED=false
# GEMINI_API_KEY=                    # easiest: a Google AI (Gemini Developer API) key; model via GEMINI_MODEL (default gemini-flash-latest)
# VERTEX_API_KEY=                     # simplest: a Vertex AI express-mode API key (starts with AQ.); then no project is needed
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=asia-south1
# VERTEX_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json      # or: VERTEX_ACCESS_TOKEN=$(gcloud auth print-access-token)
