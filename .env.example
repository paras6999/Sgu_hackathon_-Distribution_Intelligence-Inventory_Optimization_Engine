# Copy to .env (git-ignored). Bun loads .env automatically.

# --- backend
PORT=8000
ENGINE_MODE=source            # fake | source | binary
ENGINE_PORT=7010
# ENGINE_URL=http://127.0.0.1:7010   # attach to an engine you started yourself
# ENGINE_BIN=dist/dia-engine/dia-engine
# DIA_BACKEND_DATA_DIR=data/backend
# DIA_DATA_DIR=data/engine

# --- optional AI narration (M1 only; off by default; never commit real values)
AI_ENABLED=false
# VERTEX_PROJECT=
# VERTEX_LOCATION=asia-south1
# VERTEX_MODEL=gemini-4-argon
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
