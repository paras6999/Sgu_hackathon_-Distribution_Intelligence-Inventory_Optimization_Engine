{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dia/analysis",
  "title": "analysis",
  "$defs": {
    "WhatIf": {
      "additionalProperties": false,
      "description": "Scenario changes applied before a plan is generated (PRD FR-19). Defaults change nothing.",
      "properties": {
        "demand_shock_pct": { "type": "number", "minimum": -90, "maximum": 300, "default": 0 },
        "shock_region": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "depot_outage_id": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "diesel_pct": { "type": "number", "minimum": -50, "maximum": 200, "default": 0 }
      },
      "type": "object"
    },
    "AtRisk": {
      "additionalProperties": false,
      "description": "One lot of stock held by a distributor that is expected to expire before it sells (PRD FR-20).",
      "properties": {
        "holder_type": { "enum": ["depot", "distributor"], "type": "string" },
        "dist_id": { "type": "string" },
        "dist_city": { "type": "string" },
        "sku_id": { "type": "string" },
        "sku_name": { "type": "string" },
        "lot_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "expiry": { "format": "date", "type": "string" },
        "days_left": { "type": "integer" },
        "stock_cases": { "type": "number" },
        "daily_demand_cases": { "type": "number" },
        "expected_days_to_sell": { "type": "number" },
        "expected_expired_cases": { "type": "number" },
        "suggested_action": { "type": "string" }
      },
      "required": ["holder_type", "dist_id", "dist_city", "sku_id", "sku_name", "lot_id", "expiry", "days_left", "stock_cases",
        "daily_demand_cases", "expected_days_to_sell", "expected_expired_cases", "suggested_action"],
      "type": "object"
    },
    "SpaceFit": {
      "additionalProperties": false,
      "description": "How many more whole cases of one product fit in a node's free space.",
      "properties": {
        "sku_id": { "type": "string" },
        "sku_name": { "type": "string" },
        "cases": { "minimum": 0, "type": "integer" }
      },
      "required": ["sku_id", "sku_name", "cases"],
      "type": "object"
    },
    "SpaceNode": {
      "additionalProperties": false,
      "description": "Storage at one depot store (ambient or chilled) or one distributor godown on a given morning. used_m3 counts stock on hand, plus stock in transit for a distributor. Depot capacity is supply.depot_storage_weeks x the region's weekly volume; a distributor's is its storage_m3.",
      "properties": {
        "node_type": { "enum": ["depot", "distributor"], "type": "string" },
        "node_id": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "temp_class": { "anyOf": [{ "enum": ["ambient", "chilled"], "type": "string" }, { "type": "null" }],
          "description": "Store for a depot; null for a distributor godown (one space for all goods)." },
        "capacity_m3": { "minimum": 0, "type": "number" },
        "used_m3": { "minimum": 0, "type": "number" },
        "free_m3": { "minimum": 0, "type": "number" },
        "used_pct": { "minimum": 0, "type": "number" },
        "cases": { "minimum": 0, "type": "number" },
        "fits": { "items": { "$ref": "#/$defs/SpaceFit" }, "type": "array" }
      },
      "required": ["node_type", "node_id", "city", "region", "temp_class", "capacity_m3", "used_m3", "free_m3", "used_pct", "cases", "fits"],
      "type": "object"
    },
    "SpaceReport": {
      "additionalProperties": false,
      "description": "Warehouse space across the network on one morning, after plant receipts and before dispatch.",
      "properties": {
        "scenario_id": { "type": "string" },
        "as_of": { "format": "date", "type": "string" },
        "opening_state": { "enum": ["neutral", "imbalanced"], "type": "string" },
        "depots": { "items": { "$ref": "#/$defs/SpaceNode" }, "type": "array" },
        "distributors": { "items": { "$ref": "#/$defs/SpaceNode" }, "type": "array" }
      },
      "required": ["scenario_id", "as_of", "opening_state", "depots", "distributors"],
      "type": "object"
    },
    "TrajectoryPoint": {
      "additionalProperties": false,
      "properties": {
        "date": { "format": "date", "type": "string" },
        "closing_cases": { "type": "number" },
        "sales_cases": { "type": "number" },
        "lost_cases": { "type": "number" },
        "expired_cases": { "type": "number" }
      },
      "required": ["date", "closing_cases", "sales_cases", "lost_cases", "expired_cases"],
      "type": "object"
    },
    "TrajectorySeries": {
      "additionalProperties": false,
      "properties": {
        "policy": { "type": "string" },
        "points": { "items": { "$ref": "#/$defs/TrajectoryPoint" }, "type": "array" }
      },
      "required": ["policy", "points"],
      "type": "object"
    },
    "Trajectory": {
      "additionalProperties": false,
      "description": "Stock of one SKU at one distributor, day by day, for each policy in one experiment seed (PRD FR-21). Only seeds 1 and 2 keep sim logs.",
      "properties": {
        "experiment_id": { "type": "string" },
        "sku_id": { "type": "string" },
        "dist_id": { "type": "string" },
        "opening_state": { "$ref": "#/$defs/OpeningState" },
        "seed": { "type": "integer" },
        "series": { "items": { "$ref": "#/$defs/TrajectorySeries" }, "type": "array" }
      },
      "required": ["experiment_id", "sku_id", "dist_id", "opening_state", "seed", "series"],
      "type": "object"
    }
  }
}
