{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dia",
  "title": "Dia",
  "$defs": {
    "ForecastRequest": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "type": "string"
        },
        "horizon_weeks": {
          "default": 4,
          "type": "integer"
        }
      },
      "required": [
        "scenario_id",
        "as_of"
      ],
      "type": "object"
    },
    "ForecastResponse": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/ForecastRow"
          },
          "type": "array"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rows"
      ],
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "type": "string"
        },
        "temp_class": {
          "$ref": "#/$defs/TempClass"
        },
        "weights": {
          "$ref": "#/$defs/Weights",
          "default": {
            "pi_mult": 1,
            "omega_mult": 1,
            "carbon_inr_per_kg": 0
          }
        },
        "locks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Lock"
          },
          "type": "array"
        },
        "base_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scenario_id",
        "as_of",
        "temp_class"
      ],
      "type": "object"
    },
    "PublishRequest": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "PublishResponse": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "version",
        "messages"
      ],
      "type": "object"
    },
    "ResponseRequest": {
      "additionalProperties": false,
      "properties": {
        "dist_id": {
          "type": "string"
        },
        "proposal_version": {
          "type": "integer"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/LineAction"
          },
          "type": "array"
        }
      },
      "required": [
        "dist_id",
        "proposal_version",
        "actions"
      ],
      "type": "object"
    },
    "ResponseResult": {
      "additionalProperties": false,
      "properties": {
        "plan_version": {
          "type": "integer"
        },
        "proposal_version": {
          "type": "integer"
        },
        "grown_proposals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "line_diff": {
          "items": {
            "$ref": "#/$defs/LineDiff"
          },
          "type": "array"
        },
        "delta_cost_inr": {
          "type": "number"
        }
      },
      "required": [
        "plan_version",
        "proposal_version",
        "grown_proposals",
        "line_diff",
        "delta_cost_inr"
      ],
      "type": "object"
    },
    "DispatchTruck": {
      "additionalProperties": false,
      "properties": {
        "truck": {
          "$ref": "#/$defs/Truck"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/PlanLine"
          },
          "type": "array"
        }
      },
      "required": [
        "truck",
        "lines"
      ],
      "type": "object"
    },
    "DispatchResponse": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "depot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trucks": {
          "items": {
            "$ref": "#/$defs/DispatchTruck"
          },
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "version",
        "depot_id",
        "trucks"
      ],
      "type": "object"
    },
    "AssumptionRow": {
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "parameter",
        "value"
      ],
      "type": "object"
    },
    "TempClass": {
      "enum": [
        "ambient",
        "chilled"
      ],
      "type": "string"
    },
    "NodeType": {
      "enum": [
        "depot",
        "distributor"
      ],
      "type": "string"
    },
    "TruckClass": {
      "enum": [
        "AMB32",
        "REEF17"
      ],
      "type": "string"
    },
    "ShipMode": {
      "enum": [
        "FTL",
        "PTL"
      ],
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "CHEAPEST_SOURCE",
        "EXPIRY_PUSH",
        "CLIFF_RESCUE",
        "FTL_TOPUP",
        "FESTIVAL_UPLIFT",
        "WEATHER_SHIFT",
        "STOCK_LIMITED",
        "CREDIT_LIMITED",
        "STORAGE_LIMITED",
        "MRSL_BLOCKED",
        "FAIR_SHARE_FLOOR"
      ],
      "type": "string"
    },
    "PlanStatus": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "FINAL"
      ],
      "type": "string"
    },
    "LineStatus": {
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "TRIMMED",
        "REJECTED"
      ],
      "type": "string"
    },
    "ProposalStatus": {
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "TRIMMED",
        "REJECTED",
        "EXPIRED"
      ],
      "type": "string"
    },
    "ResponseAction": {
      "enum": [
        "accept",
        "trim",
        "reject"
      ],
      "type": "string"
    },
    "ExperimentStatus": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "type": "string"
    },
    "PolicyName": {
      "type": "string",
      "enum": [
        "engine",
        "baseline_a",
        "baseline_b",
        "abl_no_expiry",
        "abl_no_truck_steps",
        "abl_naive_forecast",
        "abl_no_credit",
        "abl_uniform_service",
        "abl_home_depot"
      ],
      "description": "Policy and ablation ids (FR-10, FR-12)."
    },
    "OpeningState": {
      "type": "string",
      "enum": [
        "neutral",
        "imbalanced"
      ]
    },
    "ForecastMode": {
      "enum": [
        "full",
        "seasonal_naive"
      ],
      "type": "string"
    },
    "ForecastModelKind": {
      "enum": [
        "AutoETS",
        "TSB",
        "SeasonalNaive"
      ],
      "type": "string"
    },
    "LockKind": {
      "enum": [
        "fix",
        "cap",
        "min"
      ],
      "type": "string"
    },
    "PlanEventAction": {
      "enum": [
        "accept",
        "trim",
        "reject",
        "override",
        "grow",
        "publish",
        "replan"
      ],
      "type": "string"
    },
    "Region": {
      "enum": [
        "N",
        "S",
        "E",
        "W"
      ],
      "type": "string"
    },
    "SolveStatus": {
      "enum": [
        "optimal",
        "time_limit",
        "lp_round",
        "fallback_baseline_b",
        "not_solved"
      ],
      "type": "string"
    },
    "ViolationConstraint": {
      "enum": [
        "lot_stock",
        "truck_kg",
        "truck_m3",
        "storage",
        "credit",
        "mrsl",
        "lock",
        "missing_truck",
        "missing_reason"
      ],
      "type": "string"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "dist_id": {
          "type": "string"
        },
        "proposal_version": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ProposalStatus"
        },
        "sent_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "responded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "plan_id",
        "dist_id",
        "proposal_version",
        "status"
      ],
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "dist_id": {
          "type": "string"
        },
        "proposal_version": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "total_value_inr": {
          "type": "number"
        },
        "credit_available_inr": {
          "type": "number"
        }
      },
      "required": [
        "dist_id",
        "proposal_version",
        "text",
        "line_ids",
        "total_value_inr",
        "credit_available_inr"
      ],
      "type": "object"
    },
    "LineAction": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ResponseAction"
        },
        "qty": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "line_id",
        "action"
      ],
      "type": "object"
    },
    "LineDiff": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "type": "string"
        },
        "dist_id": {
          "type": "string"
        },
        "old_cases": {
          "type": "integer"
        },
        "new_cases": {
          "type": "integer"
        }
      },
      "required": [
        "line_id",
        "dist_id",
        "old_cases",
        "new_cases"
      ],
      "type": "object"
    },
    "PlanEvent": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "plan_version": {
          "type": "integer"
        },
        "dist_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/PlanEventAction"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "old_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "new_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta_cost_inr": {
          "default": 0,
          "type": "number"
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "plan_version",
        "dist_id",
        "actor",
        "action",
        "ts"
      ],
      "type": "object"
    },
    "EngineForecastRequest": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "type": "string"
        },
        "horizon_days": {
          "default": 28,
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/ForecastMode",
          "default": "full"
        }
      },
      "required": [
        "scenario_id",
        "as_of"
      ],
      "type": "object"
    },
    "EnginePlanRequest": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "type": "string"
        },
        "temp_class": {
          "$ref": "#/$defs/TempClass"
        },
        "opening_state": {
          "$ref": "#/$defs/OpeningState",
          "default": "imbalanced"
        },
        "settings": {
          "$ref": "#/$defs/EngineSettings",
          "default": {
            "weights": {
              "carbon_inr_per_kg": 0,
              "omega_mult": 1,
              "pi_mult": 1
            },
            "no_expiry_term": false,
            "no_truck_steps": false,
            "forecast_model": "full",
            "no_credit": false,
            "uniform_service_level": false,
            "home_depot_only": false,
            "time_limit_s": 30,
            "mip_gap": 0.01
          }
        },
        "locks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Lock"
          },
          "type": "array"
        },
        "plan_id": {
          "type": "string"
        },
        "version": {
          "default": 1,
          "type": "integer"
        }
      },
      "required": [
        "scenario_id",
        "as_of",
        "temp_class",
        "plan_id"
      ],
      "type": "object"
    },
    "EngineResolveRequest": {
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "#/$defs/Plan"
        },
        "proposals": {
          "items": {
            "$ref": "#/$defs/Proposal"
          },
          "type": "array"
        },
        "response": {
          "$ref": "#/$defs/ResponseRequest"
        },
        "opening_state": {
          "$ref": "#/$defs/OpeningState",
          "default": "imbalanced"
        }
      },
      "required": [
        "plan",
        "proposals",
        "response"
      ],
      "type": "object"
    },
    "EngineHealth": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "data_dir": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "version",
        "data_dir"
      ],
      "type": "object"
    },
    "ExperimentRequest": {
      "additionalProperties": false,
      "properties": {
        "policies": {
          "default": [
            "engine",
            "baseline_a",
            "baseline_b"
          ],
          "items": {
            "$ref": "#/$defs/PolicyName"
          },
          "type": "array"
        },
        "seeds": {
          "default": 20,
          "type": "integer"
        },
        "opening_states": {
          "default": [
            "neutral",
            "imbalanced"
          ],
          "items": {
            "$ref": "#/$defs/OpeningState"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ExperimentAccepted": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "type": "string"
        },
        "cached": {
          "type": "boolean"
        }
      },
      "required": [
        "experiment_id",
        "cached"
      ],
      "type": "object"
    },
    "ExperimentInfo": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExperimentStatus"
        },
        "progress_pct": {
          "type": "number"
        },
        "config_hash": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "experiment_id",
        "status",
        "progress_pct",
        "config_hash"
      ],
      "type": "object"
    },
    "KpiSummary": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/PolicyName"
        },
        "opening_state": {
          "$ref": "#/$defs/OpeningState"
        },
        "kpi": {
          "type": "string"
        },
        "mean": {
          "type": "number"
        },
        "ci_low": {
          "type": "number"
        },
        "ci_high": {
          "type": "number"
        },
        "n_seeds": {
          "type": "integer"
        },
        "delta_vs_best_baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta_ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta_ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "policy",
        "opening_state",
        "kpi",
        "mean",
        "ci_low",
        "ci_high",
        "n_seeds"
      ],
      "type": "object"
    },
    "FrontierPoint": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/PolicyName"
        },
        "opening_state": {
          "$ref": "#/$defs/OpeningState"
        },
        "param": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "fill_rate": {
          "type": "number"
        },
        "cost_to_serve_inr": {
          "type": "number"
        }
      },
      "required": [
        "policy",
        "opening_state",
        "param",
        "value",
        "fill_rate",
        "cost_to_serve_inr"
      ],
      "type": "object"
    },
    "AblationRow": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "$ref": "#/$defs/PolicyName"
        },
        "opening_state": {
          "$ref": "#/$defs/OpeningState"
        },
        "delta_cost_to_serve_inr": {
          "type": "number"
        },
        "ci_low": {
          "type": "number"
        },
        "ci_high": {
          "type": "number"
        },
        "delta_fill_rate_pp": {
          "type": "number"
        },
        "delta_wastage_inr": {
          "type": "number"
        }
      },
      "required": [
        "variant",
        "opening_state",
        "delta_cost_to_serve_inr",
        "ci_low",
        "ci_high",
        "delta_fill_rate_pp",
        "delta_wastage_inr"
      ],
      "type": "object"
    },
    "ExperimentResults": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "type": "string"
        },
        "kpis": {
          "items": {
            "$ref": "#/$defs/KpiSummary"
          },
          "type": "array"
        },
        "frontier": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FrontierPoint"
          },
          "type": "array"
        },
        "ablation": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AblationRow"
          },
          "type": "array"
        }
      },
      "required": [
        "experiment_id",
        "kpis"
      ],
      "type": "object"
    },
    "PairForecast": {
      "additionalProperties": false,
      "description": "Daily demand distribution for one SKU x distributor from `start` for len(mean) days.\n\nWindow demand over any span = sum of daily means / variances (days independent, A27).\nConvert to a distribution with engine.dist.window_dist().",
      "properties": {
        "sku_id": {
          "type": "string"
        },
        "dist_id": {
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        },
        "mean": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "var": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "festival": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "weather": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "promo": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ForecastModelKind"
        }
      },
      "required": [
        "sku_id",
        "dist_id",
        "start",
        "mean",
        "var",
        "festival",
        "weather",
        "promo",
        "model"
      ],
      "type": "object"
    },
    "ForecastRow": {
      "additionalProperties": false,
